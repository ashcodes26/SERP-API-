# Copy to backend/.env. Never commit .env. Keys stay on the backend only.
APP_ENV=development
DATABASE_URL=sqlite:///./aimora.db
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
MAX_UPLOAD_MB=5
# Gemini-only resume analysis. Never put these in mobile/.env.
# Create a key locally at https://aistudio.google.com/api-keys; leave blank to disable AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# SerpApi (https://serpapi.com/manage-api-key). Leave empty to run without live search.
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=10
SERPAPI_MAX_RESULTS=10
JOB_CACHE_TTL_SECONDS=900
JOB_CACHE_STALE_SECONDS=86400

# Set a random signing key of at least 32 characters. Never use real student data for testing.
AUTH_SIGNING_KEY=
# Optional legacy student demo only. Admins are created with scripts.manage_accounts.
DEMO_PASSWORD=
# Temporary local login bypass. Set false to restore the login page.
# Only works with APP_ENV=development and loopback backend requests.
DEMO_LOGIN_BYPASS=false
IMPORT_RETENTION_HOURS=24

# Official LinkedIn: enable the "Sign in with LinkedIn using OpenID Connect" product.
# Register this exact HTTPS backend callback in your LinkedIn app's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Example: https://your-backend.example/api/profile/linkedin/callback
