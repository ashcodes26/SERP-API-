# Copy to backend/.env. Never commit .env. Keys stay on the backend only.
APP_ENV=development
DATABASE_URL=sqlite:///./aimora.db
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
MAX_UPLOAD_MB=5

# SerpApi (https://serpapi.com/manage-api-key). Leave empty to run without live search.
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=10
SERPAPI_MAX_RESULTS=10

# Set all three using independent strong random strings. Never use real student data in prototype imports.
AUTH_SIGNING_KEY=
ADMIN_PASSWORD=
DEMO_PASSWORD=
IMPORT_RETENTION_HOURS=24
